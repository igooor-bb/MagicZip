+        return restore_err;
+    if (stream_end < cd_start_pos)
+        return MZ_PARAM_ERROR;
+
+    /* The central directory extends from cd_start_pos to the end of its stream. */
+    zip->cd_size = stream_end - cd_start_pos;
     zip->cd_offset = 0;
