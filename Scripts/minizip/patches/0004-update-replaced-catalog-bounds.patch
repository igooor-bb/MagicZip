-    if (!zip || !cd_stream)
+    int64_t position = 0;
+    int64_t stream_end = 0;
+    int32_t err = MZ_OK;
+    int32_t restore_err = MZ_OK;
+
+    if (!zip || !cd_stream || cd_start_pos < 0)
         return MZ_PARAM_ERROR;
+
+    position = mz_stream_tell(cd_stream);
